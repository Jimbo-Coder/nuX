# -----------------------------------------------------------------------------
# Active thorns
# -----------------------------------------------------------------------------
ActiveThorns = " 
   ADMBaseX
   AsterMasks
   AsterX
   CarpetX
   Con2PrimFactory
   EOSX
   Formaline
   HydroBaseX
   IOUtil
   nuX_FakeRates
   nuX_M1
   nuX_Base
   nuX_M1_Seeds
   nuX_Utils
   ODESolvers
   TimerReport
   TmunuBaseX
   "

# -----------------------------------------------------------------------------
# Global variables
# -----------------------------------------------------------------------------
$nlevels = 1
$ncells_x = 480
$ncells_y = 400
$ncells_z = 4

# -----------------------------------------------------------------------------
# ADMBaseX
# -----------------------------------------------------------------------------
ADMBaseX::initial_data            = "Cartesian Minkowski"
ADMBaseX::initial_lapse           = "one"
ADMBaseX::initial_shift           = "zero"
ADMBaseX::initial_dtlapse         = "none"
ADMBaseX::initial_dtshift         = "none"

# -----------------------------------------------------------------------------
# AsterX
# -----------------------------------------------------------------------------
AsterX::debug_mode = "yes"
AsterX::freeze_evolution = yes
AsterX::flux_type = "LxF"
AsterX::update_tmunu = "no"

# -----------------------------------------------------------------------------
# Cactus
# -----------------------------------------------------------------------------
Cactus::cctk_show_schedule = yes

Cactus::presync_mode = "mixed-error"

Cactus::terminate = "time"
Cactus::cctk_final_time = 10.0

# -----------------------------------------------------------------------------
# CarpetX
# -----------------------------------------------------------------------------
CarpetX::verbose = yes
CarpetX::poison_undefined_values = yes
CarpetX::poison_undefined_arrays = yes

CarpetX::xmin = -2.0
CarpetX::ymin = -2.5
CarpetX::zmin = -0.1
CarpetX::xmax = 4.0
CarpetX::ymax = 2.5
CarpetX::zmax = 0.1

CarpetX::periodic = yes
CarpetX::periodic_x = no
CarpetX::periodic_y = no
CarpetX::periodic_z = yes
CarpetX::boundary_x = "neumann"
CarpetX::boundary_y = "neumann"
CarpetX::boundary_z = "none"
CarpetX::boundary_upper_x = "neumann"
CarpetX::boundary_upper_y = "neumann"
CarpetX::boundary_upper_z = "none"

CarpetX::ncells_x = $ncells_x
CarpetX::ncells_y = $ncells_y
CarpetX::ncells_z = $ncells_z
CarpetX::max_grid_size_x = 240
CarpetX::max_grid_size_y = 200
CarpetX::max_grid_size_z = 4

CarpetX::max_num_levels = $nlevels
CarpetX::regrid_every = 100000
CarpetX::blocking_factor_x = 1
CarpetX::blocking_factor_y = 1
CarpetX::blocking_factor_z = 1
CarpetX::regrid_error_threshold = 0.01

CarpetX::prolongation_type = "ddf"
CarpetX::ghost_size = 3
CarpetX::dtfac = 0.4

CarpetX::out_silo_vars = "
    HydroBaseX::rho
    HydroBaseX::vel
    HydroBaseX::eps
    HydroBaseX::press
    HydroBaseX::Bvec
    nuX_Base::rN
    nuX_Base::rE
    nuX_Base::rF
    nuX_Base::rP
"

CarpetX::out_tsv_vars = "
    HydroBaseX::rho
    HydroBaseX::vel
    HydroBaseX::eps
    HydroBaseX::press
    HydroBaseX::Bvec
    nuX_Base::rN
    nuX_Base::rE
    nuX_Base::rF
    nuX_Base::rP
"

# -----------------------------------------------------------------------------
# Con2PrimFactory
# -----------------------------------------------------------------------------
Con2PrimFactory::c2p_prime = "Noble"
Con2PrimFactory::c2p_second = "Palenzuela"
Con2PrimFactory::c2p_tol = 1e-8
Con2PrimFactory::max_iter = 100
Con2PrimFactory::rho_abs_min = 1e-8
Con2PrimFactory::unit_test = "yes"
Con2PrimFactory::B_lim = 1e8
Con2PrimFactory::vw_lim = 1e8
Con2PrimFactory::Ye_lenient = "yes"

# -----------------------------------------------------------------------------
# EOSX
# -----------------------------------------------------------------------------
EOSX::evolution_eos = "IdealGas"
EOSX::gl_gamma = 2.0
EOSX::poly_gamma = 2.0
EOSX::rho_max = 1e8
EOSX::eps_max = 1e8

# -----------------------------------------------------------------------------
# nuX_FakeRates
# -----------------------------------------------------------------------------
nuX_FakeRates::eta_nue			= 0.0
nuX_FakeRates::eta_nua			= 0.0
nuX_FakeRates::eta_nux			= 0.0
nuX_FakeRates::kappa_scat_nue		= 0.0
nuX_FakeRates::kappa_scat_nua		= 0.0
nuX_FakeRates::kappa_scat_nux		= 0.0
nuX_FakeRates::kappa_abs_nue		= 1.0
nuX_FakeRates::kappa_abs_nua		= 1.0

# -----------------------------------------------------------------------------
# IO
# -----------------------------------------------------------------------------
IO::out_dir = $parfile
IO::out_every = 10 #$ncells * 2 ** ($nlevels - 1) / 32

# -----------------------------------------------------------------------------
# ODESolvers
# -----------------------------------------------------------------------------
ODESolvers::method = "IMEX42L"

# -----------------------------------------------------------------------------
# ReconX
# -----------------------------------------------------------------------------
ReconX::reconstruction_method = "minmod"

# -----------------------------------------------------------------------------
# TimerReport
# -----------------------------------------------------------------------------
TimerReport::out_every = 10 #$ncells * 2 ** ($nlevels - 1) / 32
TimerReport::out_filename = "TimerReport"
TimerReport::output_all_timers_together = yes
TimerReport::output_all_timers_readable = yes
TimerReport::n_top_timers = 50

# -----------------------------------------------------------------------------
# nuX_M1
# -----------------------------------------------------------------------------
nuX_M1::rates_lib          = "FakeRates"
nuX_M1::add_to_Tmunu       = "no"
nuX_M1::backreact          = "no"
nuX_M1::bc_type            = "none"  #? Not sure
nuX_M1::closure            = "Minerbo"
nuX_M1::closure_epsilon    = 1e-5
nuX_M1::fiducial_velocity  = "lab"
nuX_M1::include_fluxes     = "yes"
nuX_M1::include_GR_sources = "no"
nuX_M1::source_epsabs      = 1e-10
nuX_M1::verbose            = "yes"

# -----------------------------------------------------------------------------
# nuX_M1_Seeds
# -----------------------------------------------------------------------------
nuX_M1_Seeds::verbose         = "yes"
nuX_M1_Seeds::nuX_test_case   = "shadow"
nuX_M1_Seeds::initialize_asterx_vector_potential = yes
nuX_M1_Seeds::test_nvec       = [1.0,0.0,0.0]
nuX_M1_Seeds::static_rho      = 1.0
nuX_M1_Seeds::static_eps      = 1.0e-2
nuX_M1_Seeds::static_ye       = 0.5
nuX_M1_Seeds::roi_radius      = 1.0
nuX_M1_Seeds::beam_radius     = 1.5
