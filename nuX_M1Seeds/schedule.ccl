# Schedule definitions for thorn nuX_M1Seeds

if (CCTK_Equals(nuX_test_case, "beam")) {
  SCHEDULE nuX_Seeds_SetupNeutTest_beam IN nuX_M1_InitialData {
    LANG: C
    WRITES: nuX_M1::rN(everywhere) nuX_M1::rE(everywhere) nuX_M1::rF(everywhere)
  } "Setup beam test Neutrino initial conditions."
}

if (CCTK_Equals(nuX_test_case, "equil")) {
  SCHEDULE nuX_Seeds_SetupNeutTest_equil IN nuX_M1_InitialData {
    LANG: C
    READS: ADMBaseX::metric(everywhere)
    READS: HydroBaseX::vel(everywhere)
    WRITES: nuX_M1::rN(everywhere) nuX_M1::rE(everywhere) nuX_M1::rF(everywhere)
  } "Setup thermal equilibrium test Neutrino initial conditions."
}

if (CCTK_Equals(nuX_test_case, "kerrschild")) {
  SCHEDULE nuX_Seeds_SetupNeutTest_kerrschild IN nuX_M1_InitialData {
    LANG: C
    READS: ADMBaseX::metric(everywhere) ADMBaseX::lapse(everywhere) ADMBaseX::shift(everywhere)
    WRITES: nuX_M1::rN(everywhere) nuX_M1::rE(everywhere) nuX_M1::rF(everywhere)
  } "Setup KerrSchild test Neutrino initial conditions."
  SCHEDULE nuX_Seeds_KerrInflow IN nuX_M1_BoundaryConditions AFTER nuX_M1_ApplyBCs {
    LANG: C
    READS: ADMBaseX::metric(everywhere) ADMBaseX::lapse(everywhere) ADMBaseX::shift(everywhere)
    READS: nuX_M1::rN(everywhere) nuX_M1::rE(everywhere) nuX_M1::rF(everywhere)
    WRITES: nuX_M1::rN(everywhere) nuX_M1::rE(everywhere) nuX_M1::rF(everywhere)
  } "Apply Kerr inflow boundary injection (shadow-style)."
  SCHEDULE nuX_Seeds_KerrInflow AS nuX_Seeds_KerrInflow_PreFlux \
      IN nuX_M1_RHSGroup AFTER nuX_M1_SyncConserved BEFORE nuX_M1_FiducialVelocity {
    LANG: C
    READS: ADMBaseX::metric(everywhere) ADMBaseX::lapse(everywhere) ADMBaseX::shift(everywhere)
    READS: nuX_M1::rN(everywhere) nuX_M1::rE(everywhere) nuX_M1::rF(everywhere)
    WRITES: nuX_M1::rN(everywhere) nuX_M1::rE(everywhere) nuX_M1::rF(everywhere)
  } "Refresh Kerr inflow after conserved sync and before closure/flux computations."
  SCHEDULE nuX_Seeds_KerrSchild_Mask IN nuX_M1_RHSGroup \
      AFTER nuX_M1_SetMask BEFORE nuX_M1_SyncConserved {
    LANG: C
    READS: nuX_M1::rN(everywhere) nuX_M1::rE(everywhere) nuX_M1::rF(everywhere)
    WRITES: nuX_M1::nuX_m1_mask(everywhere)
    WRITES: nuX_M1::rN(everywhere) nuX_M1::rE(everywhere) nuX_M1::rF(everywhere)
  } "Apply KerrSchild excision mask before each ODESolvers RHS evaluation."
}

if (CCTK_Equals(nuX_test_case, "adv_velocity_jump")) {
  SCHEDULE nuX_Seeds_SetupNeutTest_adv_velocity_jump IN nuX_M1_InitialData {
    LANG: C
    READS: ADMBaseX::metric(everywhere)
    READS: HydroBaseX::vel(everywhere)
    WRITES: nuX_M1::rN(everywhere) nuX_M1::rE(everywhere) nuX_M1::rF(everywhere)
  } "Setup advective step test Neutrino initial conditions."
}

if ((CCTK_Equals(nuX_test_case, "diff_limit_square")) || (CCTK_EQUALS(nuX_test_case, "diff_limit_gaussian"))) {
  SCHEDULE nuX_Seeds_SetupNeutTest_diff_limit_test IN nuX_M1_InitialData {
    LANG: C
    READS: ADMBaseX::metric(everywhere)
    READS: HydroBaseX::vel(everywhere)
    WRITES: nuX_M1::rN(everywhere) nuX_M1::rE(everywhere) nuX_M1::rF(everywhere)
  } "Setup diffusion limit test Neutrino initial conditions."
}

if (CCTK_Equals(nuX_test_case, "shadow")) {
  SCHEDULE nuX_Seeds_SetupNeutTest_shadow IN nuX_M1_InitialData {
    LANG: C
    WRITES: nuX_M1::rN(everywhere) nuX_M1::rE(everywhere) nuX_M1::rF(everywhere)
  } "Setup shadow test Neutrino initial conditions."
  SCHEDULE nuX_Seeds_ShadowBCs IN nuX_M1_BoundaryConditions AFTER nuX_M1_ApplyBCs {
    LANG: C
    WRITES: nuX_M1::rN(everywhere) nuX_M1::rE(everywhere) nuX_M1::rF(everywhere)
  } "Apply shadow test inflow boundary conditions."
}

if (CCTK_Equals(nuX_test_case, "atmosphere")) {
  SCHEDULE nuX_Seeds_SetupNeutTest_atmosphere IN nuX_M1_InitialData {
    LANG: C
    WRITES: nuX_M1::rN(everywhere) nuX_M1::rE(everywhere) nuX_M1::rF(everywhere)
  } "Setup atmosphere test Neutrino initial conditions."
}

if (CCTK_Equals(nuX_test_case, "sphere")) {
  SCHEDULE nuX_Seeds_SetupNeutTest_sphere IN nuX_M1_InitialData {
    LANG: C
    WRITES: nuX_M1::rN(everywhere) nuX_M1::rE(everywhere) nuX_M1::rF(everywhere)
  } "Setup sphere test Neutrino initial conditions."
}
